# baselines/.env.example
# Copy to baselines/.env and fill in. Nothing here is committed except this template.
# Every baseline runner reads its paths/keys/hosts from these vars — no absolute paths
# are baked into the scripts.

# ── Upstream baseline model checkouts ──────────────────────────────────────────
# Clone each upstream model repo into baselines/external/ (see baselines/external/README.md).
# Paths may be absolute or relative to the repo root.
GUI_EXPLORER_ROOT=baselines/external/GUI-explorer
PG_AGENT_ROOT=baselines/external/PG-Agent
APPAGENT_ROOT=baselines/external/AppAgent
SPA_BENCH_ROOT=baselines/external/SPA-Bench
# KG-RAG is not publicly runnable end-to-end — see baselines/droidtask_nav/README.md

# ── Navigation task data ───────────────────────────────────────────────────────
# Root holding your exported per-app navigation task folders (one subdir per app).
TAGNAV_TASKS_ROOT=/absolute/path/to/your/navigation_tasks
# Ground-truth frames root used by judges (defaults to TAGNAV_TASKS_ROOT if unset).
TAGNAV_GT_ROOT=

# Per-task navigation runner wrapped by the SPA-Bench-Nav and DroidTask-Nav adapters
# to drive OUR agent on those task sets. Defaults to the vendored runner at
# baselines/_common/nav_benchmark.py — only set this to override with your own.
# NAV_BENCHMARK_SCRIPT=
# NAV_BENCHMARK_RUNNER=     # DroidTask-Nav alias (same default)
# PREPARE_TARGETS_SCRIPT=   # defaults to baselines/_common/prepare_targets.py

# Where adapters write run outputs (defaults to ./runs if unset).
RESULTS_ROOT=

# ── DroidTask-Nav only ─────────────────────────────────────────────────────────
# DroidTask GT dataset root (states/UTGs/APK list) from the AutoDroid upstream — convert.py --gt-root.
DROIDTASK_ROOT=/absolute/path/to/DroidTask
# Raw DroidTask collector tasks to convert (input to convert.py --source-root).
DROIDTASK_COLLECTOR_ROOT=/absolute/path/to/DroidTask_collector
# Converted DroidTask-Nav v2 task tree (convert.py --out-root; consumed by run_benchmark.py + judges).
DROIDTASK_NAV_TASKS_ROOT=/absolute/path/to/DroidTask_nav_v2_DATA
# Root of your post-processed exploration graphs used as navigation memory.
EXPLORED_GRAPHS_ROOT=/absolute/path/to/explored_graphs

# ── API keys (read from the environment; never commit real keys) ───────────────
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
# If the qwen_vl backbone returns HTTP 403 (surfaces as "NoneType has no attribute
# 'choices'"), your DashScope account lacks access to the default "qwen-vl-max-latest"
# alias — set the stable fallback:
# QWEN_VL_MODEL=qwen-vl-max

# ── Optional model / retrieval servers ─────────────────────────────────────────
# GUI-Explorer needs its RAG retrieval server reachable (run it from the upstream repo).
GUI_EXPLORER_RAG_URL=http://127.0.0.1:8769
# PG-Agent policy is served separately and queried per step (see pg_agent/README.md).
PG_AGENT_SERVER_URL=http://127.0.0.1:18000/next_action

# ── Android device ─────────────────────────────────────────────────────────────
# adb serial of the running emulator/device (adb devices). Apps must be pre-installed.
ANDROID_DEVICE_SERIAL=emulator-5554
